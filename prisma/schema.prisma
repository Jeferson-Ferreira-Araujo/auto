// Plataforma SaaS de automação de publicações no Instagram — schema.
// Fonte da verdade do modelo de dados. Multiempresa: tudo pendura em Organization.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum AutoPublishStatus {
  ACTIVE
  PAUSED
}

enum InstagramConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaProcessingStatus {
  PENDING
  READY
  INCOMPATIBLE
  FAILED
}

enum SelectionStrategy {
  SEQUENTIAL
  RANDOM
  LEAST_USED
}

enum AutomationMediaType {
  IMAGE
  VIDEO
  ANY
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

enum PostSource {
  MANUAL
  AUTOMATION
}

enum PublicationOutcome {
  SUCCESS
  ERROR
}

enum PublicationPhase {
  CONTAINER
  STATUS
  PUBLISH
}

enum VideoPreset {
  NATURAL
  DINAMICO
  PROMOCAO
  ELEGANTE
}

enum PublishVariant {
  ORIGINAL
  ENHANCED
}

enum VideoJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum VideoJobKind {
  ENHANCE
  MERGE
  WATERMARK
}

enum WatermarkSize {
  SMALL
  MEDIUM
  LARGE
}

enum WatermarkPosition {
  TOP_LEFT
  TOP_CENTER
  TOP_RIGHT
  MIDDLE_LEFT
  CENTER
  MIDDLE_RIGHT
  BOTTOM_LEFT
  BOTTOM_CENTER
  BOTTOM_RIGHT
}

// ─────────────────────────── Módulo Produtos ───────────────────────────

enum ExpirationOutcome {
  PENDING
  SOLD
  DISCARDED
  PRICED_DOWN
}

// ─────────────────────────── Eventos / automação ───────────────────────────

enum DomainEventStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Papel do número autorizado no WhatsApp (identidade pelo telefone, nunca pelo conteúdo da mensagem).
enum WhatsAppRole {
  OWNER
  MANAGER
  EMPLOYEE
}

// ─────────────────────────── Núcleo multiempresa ───────────────────────────

/// Espelha auth.users do Supabase. id = uuid do Supabase Auth.
model User {
  id           String    @id @db.Uuid
  email        String    @unique
  name         String?
  isSuperAdmin Boolean   @default(false)
  blockedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships        OrganizationMember[]
  connectedInstagram InstagramAccount[]   @relation("InstagramConnectedBy")
  whatsappContacts   WhatsAppContact[]
  productsCreated    Product[]            @relation("ProductCreatedBy")
  expirationsCreated ProductExpiration[]  @relation("ExpirationCreatedBy")

  @@map("users")
}

model Organization {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  autoPublishStatus   AutoPublishStatus @default(ACTIVE)
  timezone            String            @default("America/Sao_Paulo")
  uploadLimitMb       Int               @default(200)
  mediaLimit          Int               @default(500)
  logoStorageKey      String?
  watermarkStorageKey String?
  blockedAt           DateTime?
  storageLimitMb      Int               @default(2048)
  /// Limites (configuráveis) de status de validade — dias.
  expiryWarningDays   Int               @default(30)
  expiryUrgentDays    Int               @default(7)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  members            OrganizationMember[]
  instagramAccounts  InstagramAccount[]
  categories         MediaCategory[]
  mediaAssets        MediaAsset[]
  automations        Automation[]
  scheduledPosts     ScheduledPost[]
  publicationLogs    PublicationLog[]
  whatsappContacts   WhatsAppContact[]
  videoJobs          VideoJob[]
  accountInsightDays AccountInsightDay[]
  mediaInsights      MediaInsight[]
  products           Product[]
  productExpirations ProductExpiration[]
  domainEvents       DomainEvent[]
  automationRules    AutomationRule[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String     @db.Uuid
  organizationId String
  role           MemberRole @default(OWNER)
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

// ─────────────────────────── Instagram ───────────────────────────

model InstagramAccount {
  id                String                    @id @default(cuid())
  organizationId    String
  igUserId          String
  username          String
  accountType       String?
  profilePictureUrl String?
  accessTokenCipher String // AES-256-GCM (iv:tag:ciphertext em base64)
  tokenExpiresAt    DateTime
  lastRefreshedAt   DateTime                  @default(now())
  status            InstagramConnectionStatus @default(CONNECTED)
  connectedByUserId String?                   @db.Uuid
  insightsSyncedAt  DateTime?
  insightsError     String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation("InstagramConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  automations        Automation[]
  scheduledPosts     ScheduledPost[]
  accountInsightDays AccountInsightDay[]
  mediaInsights      MediaInsight[]

  // MVP: 1 conta por organização. Remover para permitir múltiplas.
  @@unique([organizationId])
  @@map("instagram_accounts")
}

// ─────────────────────────── Categorias ───────────────────────────

model MediaCategory {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       MediaCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     MediaCategory[] @relation("CategoryTree")
  mediaAssets  MediaAsset[]
  automations  Automation[]

  @@unique([organizationId, parentId, name])
  @@index([organizationId])
  @@index([parentId])
  @@map("media_categories")
}

// ─────────────────────────── Biblioteca de mídia ───────────────────────────

model MediaAsset {
  id                  String                @id @default(cuid())
  organizationId      String
  categoryId          String?
  type                MediaType
  name                String
  storageKey          String // original no R2
  processedStorageKey String? // versão preparada p/ publicação (ex: JPEG normalizado)
  thumbnailKey        String?
  mimeType            String
  fileSize            Int
  width               Int?
  height              Int?
  duration            Float? // segundos (vídeo)
  caption             String?               @db.Text
  isActive            Boolean               @default(true)
  availableFrom       DateTime?
  availableUntil      DateTime?
  usageCount          Int                   @default(0)
  lastPublishedAt     DateTime?
  processingStatus    MediaProcessingStatus @default(PENDING)
  processingError     String?
  processingNote      String?

  // Versão melhorada para Reels (gerada pelo VideoProcessingService). Original nunca é apagado.
  enhancedStorageKey   String?
  enhancedThumbnailKey String?
  enhancedDurationSec  Float?
  publishVariant       PublishVariant @default(ORIGINAL)
  activeVideoJobId     String?

  // Marca d'água aplicada antes de publicar (renderizada sob demanda, nunca no upload).
  watermarkEnabled      Boolean           @default(false)
  watermarkPosition     WatermarkPosition @default(BOTTOM_RIGHT)
  watermarkSize         WatermarkSize     @default(MEDIUM)
  watermarkOpacity      Int               @default(85)
  watermarkedStorageKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     MediaCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  scheduledPosts ScheduledPost[]
  videoJobs      VideoJob[]

  @@index([organizationId, type])
  @@index([organizationId, isActive])
  @@index([organizationId, categoryId])
  @@map("media_assets")
}

// ─────────────────────────── Automações ───────────────────────────

model Automation {
  id                 String              @id @default(cuid())
  organizationId     String
  instagramAccountId String
  categoryId         String?
  name               String
  mediaType          AutomationMediaType @default(ANY)
  selectionStrategy  SelectionStrategy   @default(LEAST_USED)
  daysOfWeek         Int[] // 0=domingo ... 6=sábado
  publicationTime    String // "HH:mm"
  timezone           String              @default("America/Sao_Paulo")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  category         MediaCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  scheduledPosts ScheduledPost[]

  @@index([organizationId])
  @@index([isActive])
  @@map("automations")
}

// ─────────────────────────── Publicações agendadas ───────────────────────────

model ScheduledPost {
  id                   String     @id @default(cuid())
  organizationId       String
  instagramAccountId   String
  mediaAssetId         String
  automationId         String?
  source               PostSource @default(MANUAL)
  caption              String?    @db.Text
  scheduledAt          DateTime
  status               PostStatus @default(SCHEDULED)
  retryCount           Int        @default(0)
  maxRetries           Int        @default(3)
  nextAttemptAt        DateTime?
  lockedAt             DateTime?
  instagramContainerId String?
  instagramMediaId     String?    @unique
  errorMessage         String?
  publishedAt          DateTime?
  /// Identifica a ocorrência da automação: "YYYY-MM-DDTHH:mm". Evita duplicidade.
  occurrenceKey        String?
  /// Preparação p/ a Audio API da Meta (buscar/anexar áudio a Reels). Só funciona com
  /// Facebook Login — a AUTOMIDIA usa Instagram Login, então hoje ficam sempre null.
  reelAudioId          String?
  reelAudioName        String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset       @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  automation       Automation?      @relation(fields: [automationId], references: [id], onDelete: SetNull)

  publicationLogs PublicationLog[]
  mediaInsight    MediaInsight?

  @@unique([automationId, occurrenceKey])
  @@index([status, scheduledAt])
  @@index([organizationId, scheduledAt])
  @@map("scheduled_posts")
}

model PublicationLog {
  id              String             @id @default(cuid())
  organizationId  String
  scheduledPostId String
  attempt         Int
  outcome         PublicationOutcome
  phase           PublicationPhase
  message         String?
  metaResponse    Json?
  createdAt       DateTime           @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)

  @@index([scheduledPostId])
  @@index([organizationId, createdAt])
  @@map("publication_logs")
}

// ─────────────────────────── WhatsApp (Cloud API oficial) ───────────────────────────

/// Vincula um número de WhatsApp a um usuário + organização. Só contatos verificados executam comandos.
model WhatsAppContact {
  id                    String       @id @default(cuid())
  phoneE164             String       @unique
  userId                String       @db.Uuid
  organizationId        String
  verifiedAt            DateTime?
  verificationCode      String?
  verificationExpiresAt DateTime?
  lastInboundAt         DateTime?
  /// Última mídia enviada/criada por este contato — referência para "essa foto/esse vídeo".
  lastMediaAssetId      String?
  lastMediaAt           DateTime?
  /// Estado de conversa multi-passo (ex.: aguardando horário, confirmar cancelamento). Expira.
  pendingAction         Json?
  pendingExpiresAt      DateTime?
  /// AuthorizedWhatsAppUser: papel + permissões do número na organização.
  role                  WhatsAppRole @default(OWNER)
  permissions           String[]     @default([])
  active                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("whatsapp_contacts")
}

/// Idempotência e auditoria dos webhooks do WhatsApp.
model WhatsAppEvent {
  id             String   @id @default(cuid())
  wamid          String   @unique
  direction      String // INBOUND | OUTBOUND
  phoneE164      String
  organizationId String?
  messageType    String?
  bodyPreview    String?
  parsed         Json?
  status         String // RECEIVED | PROCESSED | IGNORED | FAILED
  responseText   String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([phoneE164, createdAt])
  @@index([organizationId, createdAt])
  @@map("whatsapp_events")
}

// ─────────────────────────── Melhoria automática de vídeo (Reels) ───────────────────────────

/// Job assíncrono de processamento de vídeo. Executado por um worker no GitHub Actions.
model VideoJob {
  id                 String         @id @default(cuid())
  organizationId     String
  mediaAssetId       String
  kind               VideoJobKind   @default(ENHANCE)
  preset             VideoPreset?
  inputStorageKeys   String[]       @default([])
  autoMode           Boolean        @default(false)
  titleText          String?
  includeLogo        Boolean        @default(false)
  stripAudio         Boolean        @default(false)
  status             VideoJobStatus @default(PENDING)
  progress           Int            @default(0)
  resultStorageKey   String?
  resultThumbnailKey String?
  resultDurationSec  Float?
  resultWidth        Int?
  resultHeight       Int?
  errorMessage       String?
  ffmpegSummary      String?
  attempts           Int            @default(0)
  dispatchedAt       DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset   @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([mediaAssetId])
  @@map("video_jobs")
}

// ─────────────────────────── Insights do Instagram (área Desempenho) ───────────────────────────

/// Snapshot diário de métricas da conta (1 linha por conta por dia).
model AccountInsightDay {
  id                 String   @id @default(cuid())
  organizationId     String
  instagramAccountId String
  date               DateTime @db.Date
  reach              Int      @default(0)
  views              Int      @default(0)
  followerDelta      Int      @default(0)
  followersTotal     Int?
  profileViews       Int?
  syncedAt           DateTime @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([organizationId, date])
  @@map("account_insight_days")
}

/// Métricas de uma publicação (1 linha por mídia do Instagram).
model MediaInsight {
  id                 String   @id @default(cuid())
  organizationId     String
  instagramAccountId String
  instagramMediaId   String   @unique
  scheduledPostId    String?  @unique
  mediaType          String
  mediaProductType   String
  permalink          String?
  thumbnailUrl       String?
  publishedAt        DateTime
  reach              Int      @default(0)
  views              Int      @default(0)
  likes              Int      @default(0)
  comments           Int      @default(0)
  shares             Int      @default(0)
  saved              Int      @default(0)
  totalInteractions  Int      @default(0)
  lastSyncedAt       DateTime @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  scheduledPost    ScheduledPost?   @relation(fields: [scheduledPostId], references: [id], onDelete: SetNull)

  @@index([organizationId, publishedAt])
  @@map("media_insights")
}

// ─────────────────────────── Módulo Produtos: Validades ───────────────────────────

/// Produto do estabelecimento. Não é estoque — só identifica o item da validade.
model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  barcode        String?
  active         Boolean  @default(true)
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  expirations  ProductExpiration[]

  @@unique([organizationId, barcode])
  @@index([organizationId, active])
  @@map("products")
}

/// Um registro de "N unidades deste produto vencem em tal data".
model ProductExpiration {
  id             String            @id @default(cuid())
  organizationId String
  productId      String
  quantity       Int
  expirationDate DateTime          @db.Date
  lot            String?
  location       String?
  outcome        ExpirationOutcome @default(PENDING)
  resolvedAt     DateTime?
  createdById    String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ExpirationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organizationId, expirationDate])
  @@index([organizationId, outcome, expirationDate])
  @@map("product_expirations")
}

// ─────────────────────────── Eventos entre módulos + motor de automação ───────────────────────────

/// Outbox de eventos de domínio. Produtores fazem INSERT; o cron `process-events` consome.
model DomainEvent {
  id             String            @id @default(cuid())
  organizationId String
  /// PRODUCT_EXPIRING | PRODUCT_EXPIRED | POST_PUBLISHED | POST_FAILED | AUTOMATION_FAILED
  type           String
  payload        Json
  status         DomainEventStatus @default(PENDING)
  attempts       Int               @default(0)
  error          String?
  /// Emissão idempotente (ex.: "PRODUCT_EXPIRING:<expId>").
  dedupeKey      String?           @unique
  createdAt      DateTime          @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organizationId, type, createdAt])
  @@map("domain_events")
}

/// Regra do motor de automação: TRIGGER → CONDITIONS → ACTIONS. Sem editor visual ainda.
model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Valor de trigger: PRODUCT_EXPIRING | PRODUCT_EXPIRED | POST_FAILED
  trigger        String
  conditions     Json     @default("[]")
  actions        Json     @default("[]")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, trigger, active])
  @@map("automation_rules")
}
