# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# URL pública da aplicação (sem barra final). Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Supabase (Auth + Postgres)
# Dashboard > Project Settings > API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role key (NUNCA expor no client). Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres. Dashboard > Project Settings > Database > Connection string
# DATABASE_URL: use a porta 6543 (Transaction Pooler / PgBouncer) + ?pgbouncer=true
# DIRECT_URL: use a porta 5432 (conexão direta) — usada só por `prisma migrate`
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 (armazenamento de todas as mídias)
# Cloudflare Dashboard > R2 > Manage R2 API Tokens
# ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=instapub-media
# Endpoint S3: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# ─────────────────────────────────────────────────────────────
# Meta / Instagram — Instagram API with Instagram Login
# developers.facebook.com > seu App > Instagram > API setup with Instagram login
# ─────────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
# Deve bater EXATAMENTE com a "Redirect URI" cadastrada no painel da Meta:
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# ─────────────────────────────────────────────────────────────
# Meta / WhatsApp Cloud API (opcional — sem isso a integração fica inativa)
# developers.facebook.com > seu App > WhatsApp > API Setup
# ─────────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your-test-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# Token temporário (24h) do painel, OU token de System User (permanente — recomendado)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
# App Settings > Basic > App Secret (pode ser o mesmo do INSTAGRAM_APP_SECRET se for o mesmo app)
WHATSAPP_APP_SECRET=your-meta-app-secret
# String aleatória que você inventa; a MESMA no env e no painel de Webhook da Meta
# Gere com:  node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
WHATSAPP_VERIFY_TOKEN=generate-a-random-string
WHATSAPP_GRAPH_VERSION=v22.0
# Número de teste legível (só aparece na tela de vínculo)
WHATSAPP_TEST_NUMBER=+1 555 665 5656

# ─────────────────────────────────────────────────────────────
# Segurança
# ─────────────────────────────────────────────────────────────
# Chave AES-256 (32 bytes em base64) para cifrar tokens da Meta no banco.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=generate-a-32-byte-base64-key

# Segredo compartilhado que protege as rotas /api/cron/*. String longa aleatória.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=generate-a-long-random-string
